{
  "expo": {
    "name": "BunkSmart",
    "slug": "bunksmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bunksmart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "package": "com.bunksmart.attendance",
      "versionCode": 2,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/adaptive-foreground.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D62EF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BunkSmart to choose a photo from your library for your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FFFFFF",
            "cropToolbarIconColor": "#16181A",
            "cropToolbarActionTextColor": "#16181A",
            "cropBackButtonIconColor": "#16181A",
            "cropBackgroundColor": "#F5F4F0"
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "419bf935-2183-414b-a36a-ebbd9170db57"
      }
    }
  }
}
